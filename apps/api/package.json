    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@saas/auth": "workspace:*",
    "@saas/env": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.26.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^1.1.9",
    "pg": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@saas/eslint-config": "workspace:*",
    "@saas/prettier": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
